<base:BaseUserControl
	x:Class="SCS_Mod_Helper.Modding.Accessories.AccAddon.AddVehicleUC"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Modding.Accessories.AccAddon"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	d:DataContext="{d:DesignInstance Type=local:AccAddonBinding}"
	mc:Ignorable="d">
	<Grid
		x:Name="GridMain"
		Width="450">
		<Border
			Style="{DynamicResource PopupBorder}" />
		<StackPanel
			Margin="10">
			<Grid
				Grid.ColumnSpan="5">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<TextBlock
					Grid.Row="0"
					Grid.Column="0">
					<Run
						Text="{DynamicResource VehicleManufacturer}" /><Run
						Text="." /><Run
						Text="{DynamicResource VehicleCodeName}" />
				</TextBlock>
				<Grid
					Grid.Row="1"
					Grid.Column="0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="2*" />
					</Grid.ColumnDefinitions>
					<Border
						Grid.Row="1"
						Grid.ColumnSpan="3"
						BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
						Style="{DynamicResource MultiControlBorder}" />
					<ui:TextBox
						x:Name="TextNewManifaturer"
						Grid.Row="1"
						Grid.Column="0"
						Padding="3"
						BorderBrush="Transparent"
						TextWrapping="Wrap"
						VerticalAlignment="Top" />
					<Border
						Grid.Row="1"
						Grid.Column="1"
						Margin="0,1"
						Background="{Binding ElementName=TextNewManifaturer, Path=Background}" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="1"
						Text="."
						FontSize="14"
						VerticalAlignment="Bottom" />
					<ui:TextBox
						x:Name="TextNewVehicleID"
						Grid.Row="1"
						Grid.Column="2"
						Padding="3"
						BorderBrush="Transparent"
						TextWrapping="Wrap"
						VerticalAlignment="Top" />
				</Grid>
				
				<TextBlock
					Grid.Row="0"
					Grid.Column="2"
					Text="{DynamicResource VehicleID}" />
				<ui:TextBox
					x:Name="TextVehicleID"
					Grid.Row="1"
					Grid.Column="2"
					Padding="3,3,3,3"
					TextWrapping="Wrap"
					VerticalAlignment="Top" />
				
			</Grid>

			<Grid
				Margin="0,5,0,0">
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="10" />
					<ColumnDefinition
						Width="*" />
				</Grid.ColumnDefinitions>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<TextBlock
					Grid.Row="0"
					Grid.Column="0"
					Text="{DynamicResource VehicleName}" />
				<ui:TextBox
					x:Name="TextNewDisplayName"
					Grid.Row="1"
					Grid.Column="0"
					Padding="3,3,3,3"
					TextWrapping="Wrap"
					VerticalAlignment="Top" />
				
				<TextBlock
					Grid.Row="0"
					Grid.Column="2"
					Text="{DynamicResource VehicleType}" />
				<ComboBox
					x:Name="TextNewVehicleType"
					Grid.Row="1"
					Grid.Column="2"
					Padding="3,3,3,3"
					SelectedValue="Truck"
					SelectedValuePath="Tag"
					VerticalAlignment="Top">
					<ComboBox.Items>
						<ComboBoxItem
							Content="{DynamicResource VehicleTypeTruck}"
							Tag="Truck" />
						<ComboBoxItem
							Content="{DynamicResource VehicleTypeTrailer}"
							Tag="Trailer" />
						<ComboBoxItem
							Content="{DynamicResource VehicleTypeCar}"
							Tag="Car" />
						<ComboBoxItem
							Content="{DynamicResource VehicleTypeCoach}"
							Tag="Coach" />
					</ComboBox.Items>
				</ComboBox>

				<TextBlock
					Grid.Row="0"
					Grid.Column="4"
					Text="{DynamicResource VehicleProdYear}" />
				<ui:TextBox
					x:Name="TextNewVehicleProdYear"
					Grid.Row="1"
					Grid.Column="4"
					Padding="3,3,3,3"
					TextWrapping="Wrap"
					VerticalAlignment="Top"
					PreviewTextInput="NumberOnly" />
			</Grid>

			<TextBlock
				Grid.Row="6"
				Grid.ColumnSpan="5"
				Margin="0,5,0,0"
				Text="{DynamicResource VehicleDescription}" />
			<ui:TextBox
				x:Name="TextNewDescription"
				Grid.Row="7"
				Grid.ColumnSpan="5"
				Padding="3"
				TextWrapping="Wrap"
				VerticalAlignment="Top" />
			
			<UniformGrid
				Columns="2"
				Grid.Row="9"
				Grid.ColumnSpan="5">
				<Button
					x:Name="ButtonOK"
					Content="{DynamicResource ButtonOK}"
					Margin="0,10,5,0"
					Padding="3"
					Grid.Column="0"
					Click="ButtonResultClick"
					HorizontalAlignment="Stretch">
					<Button.Style>
						<Style
							TargetType="Button"
							BasedOn="{StaticResource {x:Type Button}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding Text, ElementName=TextNewVehicleID}"
									Value="">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Text, ElementName=TextNewDisplayName}"
									Value="">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Text, ElementName=TextNewManifaturer}"
									Value="">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
								<DataTrigger
									Binding="{Binding Text, ElementName=TextNewVehicleProdYear}"
									Value="">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Button
					x:Name="ButtonCancel"
					Content="{DynamicResource ButtonCancel}"
					Margin="5,10,0,0"
					Padding="3"
					Grid.Column="2"
					Click="ButtonResultClick"
					HorizontalAlignment="Stretch" />
			</UniformGrid>
		</StackPanel>
	</Grid>
</base:BaseUserControl>
