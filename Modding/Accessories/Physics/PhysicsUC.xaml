<base:BaseUserControl
	x:Class="SCS_Mod_Helper.Modding.Accessories.Physics.PhysicsUC"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Modding.Accessories.Physics"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	xmlns:cls="clr-namespace:SCS_Mod_Helper.Class"
	xmlns:utils="clr-namespace:SCS_Mod_Helper.Utils"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:acc="clr-namespace:SCS_Mod_Helper.Modding.Accessories"
	d:DataContext="{d:DesignInstance Type=local:PhysicsBinding}"
	mc:Ignorable="d"
	d:Background="White"
	ScrollViewer.CanContentScroll="True"
	ScrollViewer.VerticalScrollBarVisibility="Auto">
	<base:BaseUserControl.Resources>
		<utils:FloatConverter
			x:Key="FloatConverter" />
		<ContextMenu
			x:Key="MenuPhysicsType">
			<MenuItem
				x:Name="PhysicsToyData"
				Tag="physics_toy_data"
				Header="{DynamicResource PhysicsTypeToy}"
				Click="AddPhysicDataClick" />
			<MenuItem
				x:Name="PhysicsPatchData"
				Tag="physics_patch_data"
				Header="{DynamicResource PhysicsTypePatch}"
				Click="AddPhysicDataClick" />
		</ContextMenu>

		<Style
			x:Key="Float2BoxStyle"
			TargetType="cls:Float3Box"
			BasedOn="{StaticResource {x:Type cls:Float3Box}}">
			<Setter
				Property="Length"
				Value="2" />
			<Setter
				Property="FontSize"
				Value="14" />
		</Style>

		<Style
			x:Key="TextBoxBorderless"
			TargetType="ui:TextBox"
			BasedOn="{StaticResource {x:Type ui:TextBox}}">
			<Setter
				Property="VerticalAlignment"
				Value="Stretch" />
			<Setter
				Property="BorderThickness"
				Value="0" />
		</Style>
		<Style
			x:Key="ButtonBorderless"
			TargetType="Button"
			BasedOn="{StaticResource {x:Type Button}}">
			<Setter
				Property="VerticalAlignment"
				Value="Stretch" />
			<Setter
				Property="BorderThickness"
				Value="0" />
			<Setter
				Property="Padding"
				Value="2" />
			<Setter
				Property="Background"
				Value="{x:Null}" />
			<Setter
				Property="Width"
				Value="{Binding ActualHeight, ElementName=TextPhysicsName}" />
			<Setter
				Property="Height"
				Value="{Binding ActualHeight, ElementName=TextPhysicsName}" />
		</Style>
	</base:BaseUserControl.Resources>
	<Grid
		x:Name="GridMain">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="110" />
			<ColumnDefinition
				Width="15" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Grid
			Grid.Row="0"
			Grid.RowSpan="2"
			Height="{Binding ActualHeight, ElementName=GridPhysics, Mode=OneWay}">
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
			</Grid.RowDefinitions>
			<Border
				Grid.Column="1"
				Grid.ColumnSpan="4"
				Style="{DynamicResource MultiControlBorder}" />
			<Button
				x:Name="ButtonPhysicAdd"
				Grid.Column="1"
				Click="ButtonAddRowClick"
				Width="20"
				Height="20"
				Padding="2"
				VerticalAlignment="Stretch">
				<Viewbox>
					<ui:SymbolIcon
						Symbol="Add16" />
				</Viewbox>
			</Button>
			<Button
				x:Name="ButtonPhysicUp"
				Grid.Column="2"
				Click="SortButtonClick"
				Width="20"
				Height="20"
				Padding="2"
				VerticalAlignment="Stretch">
				<Viewbox>
					<ui:SymbolIcon
						Symbol="ArrowUp16" />
				</Viewbox>
				<Button.Style>
					<Style
						TargetType="Button"
						BasedOn="{StaticResource {x:Type Button}}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding SelectedIndex, ElementName=ListBoxPhysics}"
								Value="-1">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
							<DataTrigger
								Binding="{Binding ItemsSource.Count, ElementName=ListBoxPhysics}"
								Value="1">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button
				x:Name="ButtonPhysicDown"
				Grid.Column="3"
				Click="SortButtonClick"
				Width="20"
				Height="20"
				Padding="2"
				VerticalAlignment="Stretch">
				<Viewbox>
					<ui:SymbolIcon
						Symbol="ArrowDown16" />
				</Viewbox>
				<Button.Style>
					<Style
						TargetType="Button"
						BasedOn="{StaticResource {x:Type Button}}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding SelectedIndex, ElementName=ListBoxPhysics}"
								Value="-1">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
							<DataTrigger
								Binding="{Binding ItemsSource.Count, ElementName=ListBoxPhysics}"
								Value="1">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Button
				x:Name="ButtonPhysicRemove"
				Grid.Column="4"
				Click="ButtonDeleteRowClick"
				Width="20"
				Height="20"
				Padding="2"
				VerticalAlignment="Stretch">
				<Viewbox>
					<ui:SymbolIcon
						Symbol="Dismiss16" />
				</Viewbox>
				<Button.Style>
					<Style
						TargetType="Button"
						BasedOn="{StaticResource {x:Type Button}}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding SelectedIndex, ElementName=ListBoxPhysics}"
								Value="-1">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
			<Border
				Grid.Row="1"
				Grid.RowSpan="2"
				Grid.ColumnSpan="5"
				BorderThickness="1"
				BorderBrush="{DynamicResource TextControlElevationBorderBrush}"
				CornerRadius="4" />
			<TextBlock
				Text="{DynamicResource HeaderPhysicsName}"
				HorizontalAlignment="Left"
				VerticalAlignment="Bottom"
				Grid.Row="1"
				Grid.ColumnSpan="5"
				Padding="0,5"
				FontWeight="Bold"
				Margin="10,0,0,0" />
			<ListBox
				x:Name="ListBoxPhysics"
				Grid.Row="2"
				Grid.ColumnSpan="5"
				d:ItemsSource="{d:SampleData ItemCount=2}"
				ItemsSource="{Binding PhysicsItems}"
				SelectedItem="{Binding CurrentPhysicsItem}"
				SelectedIndex="0"
				SelectionMode="Single">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Text="{Binding PhysicsName}"
							ToolTip="{Binding PhysicsName}"
							FontSize="13">
							<TextBlock.Style>
								<Style
									TargetType="TextBlock"
									BasedOn="{StaticResource {x:Type TextBlock}}">
									<Style.Triggers>
										<DataTrigger
											Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}"
											Value="True">
											<Setter
												Property="Foreground"
												Value="White" />
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</Grid>

		<GridSplitter
			Width="1"
			Grid.Row="0"
			Grid.RowSpan="2"
			Grid.Column="1"
			Margin="4,0"
			ResizeBehavior="PreviousAndNext"
			HorizontalAlignment="Center"
			Background="#FF4C4B4B" />

		<Grid
			x:Name="GridPhysics"
			Grid.Row="1"
			Grid.Column="2">
			<Grid.Style>
				<Style
					TargetType="Grid">
					<Style.Triggers>
						<DataTrigger
							Binding="{Binding ItemsSource.Count, ElementName=ListBoxPhysics, Mode=OneWay}"
							Value="0">
							<Setter
								Property="Visibility"
								Value="Hidden" />
						</DataTrigger>
					</Style.Triggers>
				</Style>
			</Grid.Style>
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>

			<StackPanel
				x:Name="PanelSaveButton"
				Orientation="Horizontal">
				<Button
					x:Name="ButtonAddToDataClick"
					Content="{DynamicResource ButtonAddToData}"
					Padding="5,2"
					Click="ButtonPhysicsClick">
					<Button.Style>
						<Style
							TargetType="Button"
							BasedOn="{StaticResource {x:Type Button}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding SelectedIndex, ElementName=ListBoxPhysics}"
									Value="-1">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
				<Button
					x:Name="ButtonSaveToPhysList"
					Margin="5,0,0,0"
					Content="{DynamicResource ButtonSaveToPhysicList}"
					Padding="5,2"
					Click="ButtonPhysicsClick">
					<Button.Style>
						<Style
							TargetType="Button"
							BasedOn="{StaticResource {x:Type Button}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding SelectedIndex, ElementName=ListBoxPhysics}"
									Value="-1">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</StackPanel>
			<DockPanel
				Grid.Row="1"
				Margin="0,5">
				<TextBlock
					VerticalAlignment="Center"
					Padding="0"
					Text="{DynamicResource TitlePhysicsType}" />
				<TextBlock
					x:Name="ComboPhysicsType"
					Grid.Column="1"
					Margin="5,0,0,0"
					Text="{Binding PhysicsType}"
					VerticalAlignment="Center" />
			</DockPanel>

			<Grid
				x:Name="PanelPTD"
				Grid.Row="2"
				d:Visibility="Visible"
				Visibility="{Binding ToyVisibility}">
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="Auto" />
				</Grid.RowDefinitions>
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="10" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="10" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="10" />
						<RowDefinition
							Height="Auto" />
						<RowDefinition
							Height="10" />
						<RowDefinition
							Height="Auto" />
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" 
							MinWidth="200"/>
						<ColumnDefinition
							Width="5" />
						<ColumnDefinition
							Width="*"
							MinWidth="200" />
						<ColumnDefinition
							Width="5" />
						<ColumnDefinition
							Width="*"
							MinWidth="200" />
						<ColumnDefinition
							Width="5" />
						<ColumnDefinition
							Width="*"
							MinWidth="200" />
					</Grid.ColumnDefinitions>
					<StackPanel>
						<TextBlock
							Text="{DynamicResource TitlePhysicsName}" />
						<ui:TextBox
							x:Name="TextPhysicsName"
							Padding="3"
							ClearButtonEnabled="False"
							Text="{Binding CurrentToyData.PhysicsName, UpdateSourceTrigger=PropertyChanged}">
							<ui:TextBox.Style>
								<Style
									TargetType="ui:TextBox"
									BasedOn="{StaticResource {x:Type ui:TextBox}}">
									<Style.Triggers>
										<Trigger
											Property="Text"
											Value="">
											<Setter
												Property="Background"
												Value="Yellow" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</ui:TextBox.Style>
						</ui:TextBox>
					</StackPanel>
					<StackPanel
						Grid.Column="2">
						<TextBlock
							Text="{DynamicResource TitleToyType}" />
						<ComboBox
							x:Name="TextToyType"
							IsEditable="True"
							IsReadOnly="True"
							Text="{Binding CurrentToyData.ToyType, UpdateSourceTrigger=PropertyChanged}">
							<ComboBox.Items>
								<ComboBoxItem
									Content="TT_rope" />
								<ComboBoxItem
									Content="TT_double_rope" />
								<ComboBoxItem
									Content="TT_joint" />
								<ComboBoxItem
									Content="TT_joint_free" />
							</ComboBox.Items>
						</ComboBox>
					</StackPanel>
					<Grid
						Grid.Column="4"
						Grid.ColumnSpan="3">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock
							Grid.ColumnSpan="2"
							TextWrapping="Wrap"
							VerticalAlignment="Top"
							Text="{DynamicResource ModelFilePath}" />
						<Border
							Grid.Row="1"
							Grid.ColumnSpan="2"
							Style="{DynamicResource MultiControlBorder}" />
						<ui:TextBox
							x:Name="TextPhysicsModelPath"
							Grid.Row="1"
							Padding="3"
							Text="{Binding CurrentToyData.ModelPath, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="Wrap"
							MaxLines="2">
							<ui:TextBox.Style>
								<Style
									TargetType="ui:TextBox"
									BasedOn="{StaticResource TextBoxBorderless}">
									<Style.Triggers>
										<Trigger
											Property="Text"
											Value="">
											<Setter
												Property="Background"
												Value="Yellow" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</ui:TextBox.Style>
						</ui:TextBox>
						<Button
							x:Name="ButtonChoosePhysicsModel"
							Grid.Row="1"
							Grid.Column="1"
							Click="ButtonChooseModelClick"
							Tag="{x:Static acc:ChooseModelType.Model}"
							Style="{StaticResource ButtonBorderless}">
							<Viewbox>
								<ui:SymbolIcon
									Symbol="Folder16" />
							</Viewbox>
						</Button>
					</Grid>

					<StackPanel
						Grid.Row="2"
						Grid.Column="0">
						<TextBlock
							TextWrapping="Wrap"
							VerticalAlignment="Top"
							Text="{DynamicResource ModelLook}" />
						<ComboBox
							x:Name="TextPhysicsLook"
							Text="{Binding CurrentToyData.Look}"
							ItemsSource="{Binding CurrentToyData.LookList}"
							IsEditable="True"
							IsTextSearchEnabled="True" />
					</StackPanel>
					<StackPanel
						Grid.Row="2"
						Grid.Column="2">
						<TextBlock
							TextWrapping="Wrap"
							VerticalAlignment="Top"
							Text="{DynamicResource ModelVariant}" />
						<ComboBox
							x:Name="TextPhysicsVariant"
							Text="{Binding CurrentToyData.Variant}"
							ItemsSource="{Binding CurrentToyData.VariantList}"
							IsEditable="True"
							IsTextSearchEnabled="True" />
					</StackPanel>
					<Grid
						Grid.Row="2"
						Grid.Column="4"
						Grid.ColumnSpan="3">
						<Grid.RowDefinitions>
							<RowDefinition
								Height="Auto" />
							<RowDefinition
								Height="*" />
						</Grid.RowDefinitions>
						<Grid.ColumnDefinitions>
							<ColumnDefinition
								Width="*" />
							<ColumnDefinition
								Width="Auto" />
						</Grid.ColumnDefinitions>
						<Border
							Grid.Row="1"
							Grid.ColumnSpan="2"
							Style="{DynamicResource MultiControlBorder}" />
						<TextBlock
							x:Name="CheckUsePhysicsCollPath"
							Grid.ColumnSpan="2"
							VerticalAlignment="Top"
							Text="{DynamicResource ModelCollPath}" />
						<ui:TextBox
							x:Name="TextPhysicsCollPath"
							Grid.Row="1"
							Padding="3"
							Text="{Binding CurrentToyData.CollPath, UpdateSourceTrigger=PropertyChanged}"
							TextWrapping="Wrap"
							MaxLines="2"
							Style="{StaticResource TextBoxBorderless}" />
						<Button
							x:Name="ButtonChoosePhysicsColl"
							Grid.Row="1"
							Grid.Column="1"
							Click="ButtonChooseModelClick"
							Tag="{x:Static acc:ChooseModelType.Coll}"
							Style="{StaticResource ButtonBorderless}">
							<Viewbox>
								<ui:SymbolIcon
									Symbol="Folder16" />
							</Viewbox>
						</Button>
					</Grid>

					<StackPanel
						Grid.Row="4">
						<TextBlock
							Text="{DynamicResource TitleToyMass}" />
						<ui:TextBox
							x:Name="TextToyMass"
							ClearButtonEnabled="False"
							PlaceholderText="0.1"
							Text="{Binding CurrentToyData.Mass, Converter={x:Static utils:FloatConverter.Instance}}"
							PreviewTextInput="FloatOnly" />
					</StackPanel>
					<StackPanel
						Grid.Row="4"
						Grid.Column="2">
						<TextBlock
							Text="{DynamicResource TitleCogOffset}" />
						<cls:Float3Box
							Floats="{Binding CurrentToyData.CogOffset}"
							DefaultValue0="0"
							DefaultValue1="0"
							DefaultValue2="0"/>
					</StackPanel>
					<StackPanel
						Grid.Row="4"
						Grid.Column="4">
						<TextBlock
							ToolTip="{DynamicResource TipLinearStiffness}"
							Text="{DynamicResource TitleLinearStiffness}" />
						<ui:TextBox
							x:Name="TextLinearStiffness"
							ClearButtonEnabled="False"
							Text="{Binding CurrentToyData.LinearStiffness, Converter={x:Static utils:FloatConverter.Instance}}"
							PlaceholderText="1.0"
							PreviewTextInput="FloatOnly" />
					</StackPanel>
					<StackPanel
						Grid.Row="4"
						Grid.Column="6">
						<TextBlock
							ToolTip="{DynamicResource TitleLinearDamping}"
							Text="{DynamicResource TitleLinearDamping}" />
						<ui:TextBox
							x:Name="TextLinearDamping"
							ClearButtonEnabled="False"
							Text="{Binding CurrentToyData.LinearDamping, Converter={x:Static utils:FloatConverter.Instance}}"
							PlaceholderText="0.5"
							PreviewTextInput="FloatOnly" />
					</StackPanel>

					<StackPanel
						Grid.Row="6"
						Grid.Column="0">
						<TextBlock
							ToolTip="{DynamicResource TipLocatorHookOffset}"
							Text="{DynamicResource TitleLocatorHookOffset}" />
						<cls:Float3Box
							Floats="{Binding CurrentToyData.LocatorHookOffset}"
							DefaultValue0="0"
							DefaultValue1="0"
							DefaultValue2="0"/>
					</StackPanel>
					<StackPanel
						Grid.Row="6"
						Grid.Column="2">
						<TextBlock
							Text="{DynamicResource TitleRestPositionOffset}" />
						<cls:Float3Box
							Floats="{Binding CurrentToyData.RestPositionOffset}"
							DefaultValue0="0"
							DefaultValue1="0"
							DefaultValue2="0" />
					</StackPanel>
					<StackPanel
						Grid.Row="6"
						Grid.Column="4">
						<TextBlock
							Text="{DynamicResource TitleRestRotationOffset}" />
						<cls:Float3Box
							Floats="{Binding CurrentToyData.RestRotationOffset}"
							DefaultValue0="0"
							DefaultValue1="0"
							DefaultValue2="0" />
					</StackPanel>
					<StackPanel
						Grid.Row="6"
						Grid.Column="6">
						<TextBlock
							x:Name="TitleInstanceOffset"
							VerticalAlignment="Bottom"
							Text="{DynamicResource TitleInstanceOffset}" />
						<Grid
							Grid.Row="1"
							Grid.ColumnSpan="4">
							<Grid.ColumnDefinitions>
								<ColumnDefinition
									Width="*" />
								<ColumnDefinition
									Width="Auto" />
							</Grid.ColumnDefinitions>
							<cls:Float3Box
								Floats="{Binding CurrentToyData.CurrentInstanceOffset}">
								<cls:Float3Box.Style>
									<Style
										TargetType="cls:Float3Box"
										BasedOn="{StaticResource {x:Type cls:Float3Box}}">
										<Style.Triggers>
											<DataTrigger
												Binding="{Binding CurrentToyData.InstanceOffsetList.Count}"
												Value="0">
												<Setter
													Property="IsEnabled"
													Value="False" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</cls:Float3Box.Style>
							</cls:Float3Box>
							<Button
								x:Name="ButtonInstanceOffsetList"
								Grid.Column="1"
								Width="{Binding ActualHeight, Mode=OneWay, RelativeSource={RelativeSource Self}}"
								Click="ButtonInstanceOffsetClicked"
								VerticalAlignment="Stretch"
								HorizontalAlignment="Left">
								<ui:SymbolIcon
									Symbol="AppsList20" />
							</Button>
							<Popup
								x:Name="PopupInstanceOffsetList"
								Placement="Bottom"
								PopupAnimation="Slide"
								AllowsTransparency="True"
								PlacementTarget="{Binding ElementName=ButtonInstanceOffsetList}"
								StaysOpen="False">
								<Grid
									MinWidth="167">
									<Border
										Grid.RowSpan="2"
										Style="{DynamicResource PopupBorder}" />
										<Grid
										Margin="5">
										<Grid.RowDefinitions>
											<RowDefinition
												Height="Auto" />
											<RowDefinition
												Height="Auto" />
										</Grid.RowDefinitions>
										<Button
											Padding="10,3"
											Margin="5"
											HorizontalAlignment="Right"
											Command="{Binding CurrentToyData.AddInstanceOffsetCommand}">
											<Viewbox>
												<ui:SymbolIcon
													Symbol="Add20" />
											</Viewbox>
										</Button>
										<TextBlock
											Grid.Row="1"
											Margin="5"
											Text="{DynamicResource StatusEmpty}"
											HorizontalAlignment="Right">
											<TextBlock.Style>
												<Style
													TargetType="TextBlock"
													BasedOn="{StaticResource {x:Type TextBlock}}">
													<Setter
														Property="Visibility"
														Value="Collapsed" />
													<Style.Triggers>
														<DataTrigger
															Binding="{Binding CurrentToyData.InstanceOffsetList.Count}"
															Value="0">
															<Setter
																Property="Visibility"
																Value="Visible" />
														</DataTrigger>
													</Style.Triggers>
												</Style>
											</TextBlock.Style>
										</TextBlock>
										<ListBox
											x:Name="ListBoxInstanceOffset"
											Grid.Row="1"
											Margin="5"
											ItemsSource="{Binding CurrentToyData.InstanceOffsetList}"
