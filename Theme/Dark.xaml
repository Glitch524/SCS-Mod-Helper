<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:colorpicker="clr-namespace:ColorPicker;assembly=ColorPicker">

	<Style
		x:Key="BaseWindowStyle"
		TargetType="ui:FluentWindow"
		BasedOn="{StaticResource {x:Type ui:FluentWindow}}">
		<Setter
			Property="Background"
			Value="Black" />
	</Style>
	<Style
		TargetType="Button"
		BasedOn="{StaticResource {x:Type Button}}">
		<Setter
			Property="Padding"
			Value="0" />
		<Setter
			Property="Background"
			Value="{DynamicResource ButtonBackground}" />
	</Style>
	<Style
		TargetType="ui:SplitButton"
		BasedOn="{StaticResource {x:Type ui:SplitButton}}">
		<Setter
			Property="Background"
			Value="{DynamicResource ButtonBackground}" />
	</Style>

	<Style
		x:Key="TableTextBoxStyle"
		TargetType="TextBox"
		BasedOn="{StaticResource TableTextBoxBaseStyle}">
		<Style.Triggers>
			<Trigger
				Property="IsFocused"
				Value="False">
				<Setter
					Property="Background"
					Value="{x:Null}" />
			</Trigger>
			<MultiDataTrigger>
				<MultiDataTrigger.Conditions>
					<Condition
						Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGridCell}, Path=IsSelected}"
						Value="True" />
					<Condition
						Binding="{Binding RelativeSource={RelativeSource Self}, Path=IsFocused}"
						Value="False" />
					<Condition
						Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=DataGrid}, Path=IsKeyboardFocusWithin}"
						Value="False" />
				</MultiDataTrigger.Conditions>
				<MultiDataTrigger.Setters>
					<Setter
						Property="Foreground"
						Value="Black" />
				</MultiDataTrigger.Setters>
			</MultiDataTrigger>
		</Style.Triggers>
	</Style>

	<Style
		x:Key="ColorPickerStyle"
		TargetType="colorpicker:StandardColorPicker"
		BasedOn="{StaticResource DefaultColorPickerStyle}">
	</Style>
</ResourceDictionary>