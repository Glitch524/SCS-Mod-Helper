<base:BaseWindow
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:SCS_Mod_Helper.ConverterPix"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	d:DataContext="{d:DesignInstance Type=local:ConverterPixBinding}"
	x:Class="SCS_Mod_Helper.ConverterPix.ConverterPixWindow"
	ExtendsContentIntoTitleBar="True"
	mc:Ignorable="d"
	Title="{DynamicResource TitleConverterPIX}"
	WindowStartupLocation="CenterOwner"
	Height="600"
	Width="900">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<ui:TitleBar
			Title="{DynamicResource TitleConverterPIX}"
			Icon="{ui:SymbolIcon BoxSearch20, FontSize=20}" />
		<Grid
			x:Name="GridMain"
			Margin="10"
			Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<Grid >
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<CheckBox
					x:Name="CheckBoxCustomExportPath"
					Grid.Column="0"
					Content="{DynamicResource TitleCustomExportPath}"
					IsChecked="{Binding UseCustomDestPath}"
					FontSize="12" />
				<ui:TextBox
					Grid.Column="1"
					Text="{Binding CustomExportPath}"
					ClearButtonEnabled="False">
					<ui:TextBox.Style>
						<Style
							TargetType="ui:TextBox"
							BasedOn="{StaticResource {x:Type ui:TextBox}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding IsChecked, ElementName=CheckBoxCustomExportPath}"
									Value="False">
									<Setter
										Property="IsEnabled"
										Value="False" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</ui:TextBox.Style>
				</ui:TextBox>
				<Button
					x:Name="ButtonChooseDest"
					Content="{DynamicResource ButtonBrowse}"
					Grid.Column="2"
					Command="{Binding ChooseExportPathCommand}"
					Padding="10,4"
					Margin="5,0,0,0"
					d:Visibility="Visible"
					Cursor="">
					<Button.Style>
						<Style
							TargetType="Button"
							BasedOn="{StaticResource {x:Type Button}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding IsChecked, ElementName=CheckBoxCustomExportPath}" 
									Value="False">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</Button.Style>
				</Button>
			</Grid>

			<DockPanel
				Grid.Row="1">
				<TabControl
					x:Name="TabPackages"
					d:ItemsSource="{d:SampleData ItemCount=3}"
					ItemsSource="{Binding PackList}"
					SelectedValue="{Binding CurrentPack}"
					VerticalAlignment="Top"
					d:SelectedIndex="0">
					<TabControl.ItemTemplate>
						<DataTemplate>
							<StackPanel
								Orientation="Horizontal">
								<TextBlock
									Text="{Binding PackName}"/>
								<Button
									Margin="5,0,0,0"
									BorderThickness="0"
									Command="{Binding ElementName=TabPackages, Path=DataContext.ClosePackCommand}"
									CommandParameter="{Binding .}">
									<Viewbox>
										<ui:SymbolIcon
											Symbol="Dismiss20" />
									</Viewbox>
								</Button>
							</StackPanel>
						</DataTemplate>
					</TabControl.ItemTemplate>
					<TabControl.ContentTemplate>
						<DataTemplate />
					</TabControl.ContentTemplate>
				</TabControl>
				<Button
					Margin="5,10,0,3"
					Height="24"
					Command="{Binding AddPackCommand}">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="Add20" />
					</Viewbox>
				</Button>
			</DockPanel>
			<Border
				Grid.Row="1"
				Height="1"
				BorderBrush="LightGray"
				BorderThickness="1"
				VerticalAlignment="Bottom" />
			
			<Grid
				x:Name="GridContent"
				Grid.Row="2">
				<Grid.Style>
					<Style
						TargetType="Grid">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding ElementName=TabPackages, Path=SelectedIndex}"
								Value="-1">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<Grid.RowDefinitions>
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="5" />
					<RowDefinition
						Height="Auto" />
					<RowDefinition
						Height="*" />
				</Grid.RowDefinitions>
				<Border
					Grid.RowSpan="4"
					BorderThickness="1,0,1,1"
					BorderBrush="LightGray" />
				<Grid
					Margin="0,5,0,0">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock
						Margin="5,0,0,0"
						TextWrapping="Wrap"
						Text="{DynamicResource TitlePackPath}"
						VerticalAlignment="Center" />
					<ui:TextBox
						x:Name="BoxFile"
						Grid.Column="1"
						ClearButtonEnabled="False"
						Margin="0,0,5,0"
						Text="{Binding CurrentPack.PackPath}" />
					<Button
						x:Name="ButtonChooseFile"
						Content="{DynamicResource ButtonBrowse}"
						Grid.Column="2"
						Command="{Binding ChoosePackCommand}"
						Padding="10,5"
						Margin="0,0,5,0" />
				</Grid>

				<Border
					Grid.Row="2"
					BorderThickness="0,1"
					BorderBrush="LightGray" />

				<Grid
					Grid.Row="2">
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="Auto" />
						<ColumnDefinition
							Width="*" />
					</Grid.ColumnDefinitions>

					<Rectangle
						Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
					<Button
						x:Name="ButtonBack"
						ToolTip="{DynamicResource TooltipGoBack}"
						Command="{Binding UndoCommand}"
						Background="{x:Null}"
						BorderBrush="{x:Null}"
						VerticalAlignment="Stretch"
						HorizontalAlignment="Stretch">
						<Button.Style>
							<Style
								TargetType="Button"
								BasedOn="{StaticResource {x:Type Button}}">
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding CurrentPack.HistoryUndoList.Count, Mode=OneWay}"
										Value="0">
										<Setter
											Property="IsEnabled"
											Value="False" />
										<Setter
											Property="Foreground"
											Value="LightGray" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<Viewbox>
							<ui:SymbolIcon
								Symbol="ArrowLeft20"
								FontSize="20">
							</ui:SymbolIcon>
						</Viewbox>
					</Button>

					<Rectangle
						Grid.Column="1"
						Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
					<Button
						x:Name="ButtonReturn"
						Command="{Binding FolderBackCommand}"
						Grid.Column="1"
						Background="{x:Null}"
						BorderBrush="{x:Null}"
						VerticalAlignment="Stretch"
						HorizontalAlignment="Stretch">
						<Button.Style>
							<Style
								TargetType="Button"
								BasedOn="{StaticResource {x:Type Button}}">
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding CurrentPack.PathList.Count, Mode=OneWay}"
										Value="0">
										<Setter
											Property="IsEnabled"
											Value="False" />
										<Setter
											Property="Foreground"
											Value="LightGray" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding CurrentPack.PathList.Count, Mode=OneWay}"
										Value="1">
										<Setter
											Property="IsEnabled"
											Value="False" />
										<Setter
											Property="Foreground"
											Value="LightGray" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
						<Viewbox>
							<ui:SymbolIcon
								Symbol="ArrowUp20"
								FontSize="20">
							</ui:SymbolIcon>
						</Viewbox>
					</Button>

					<ui:BreadcrumbBar
						Margin="5"
						Grid.Column="2"
						d:ItemsSource="{d:SampleData ItemCount=2}"
						ItemsSource="{Binding CurrentPack.PathList}"
						ItemClicked="BreadcrumbBarItemClicked"
						MinHeight="20">
						<ui:BreadcrumbBar.ItemTemplate>
							<DataTemplate>
								<TextBlock
									Text="{Binding Title}"
									ToolTip="{Binding Title}" />
							</DataTemplate>
						</ui:BreadcrumbBar.ItemTemplate>
					</ui:BreadcrumbBar>
				</Grid>

				<Border
					Grid.Row="3"
					BorderThickness="1,0,1,1"
					BorderBrush="LightGray" />

				<ListBox
					x:Name="ListFiles"
					Grid.Row="3"
					d:ItemsSource="{d:SampleData ItemCount=2}"
					ItemsSource="{Binding CurrentPack.FileList}"
					SelectedItem="{Binding CurrentPack.SelectedFile}"
					SelectionMode="Single"
					FocusVisualStyle="{x:Null}"
					KeyDown="ListBoxKeyDown">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<Grid
								Margin="0,5">
								<Grid.InputBindings>
									<MouseBinding
										Command="{Binding DataContext.OpenFileCommand, ElementName=ListFiles}"
										CommandParameter="{Binding}"
										MouseAction="LeftDoubleClick" />
								</Grid.InputBindings>
								<Grid.ColumnDefinitions>
									<ColumnDefinition
										Width="Auto" />
									<ColumnDefinition
										Width="5" />
									<ColumnDefinition
										Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition
										Height="Auto" />
									<RowDefinition
										Height="Auto" />
								</Grid.RowDefinitions>
								<Border
									Grid.ColumnSpan="3"
									Grid.RowSpan="2" />
								<TextBlock
									Grid.ColumnSpan="3"
									Grid.RowSpan="2" />
								<Rectangle
									Grid.RowSpan="2"
									Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}" />
								<Viewbox
									Grid.RowSpan="2"
									Stretch="Uniform">
									<ui:SymbolIcon>
										<ui:SymbolIcon.Style>
											<Style
												TargetType="ui:SymbolIcon">
												<Setter
													Property="Symbol"
													Value="Document20" />
												<Style.Triggers>
													<DataTrigger
														Binding="{Binding IsDir}"
														Value="True">
														<Setter
															Property="Symbol"
															Value="Folder20" />
													</DataTrigger>
												</Style.Triggers>
											</Style>
										</ui:SymbolIcon.Style>
									</ui:SymbolIcon>
								</Viewbox>
								<TextBlock
									Text="{Binding Title}"
									ToolTip="{Binding Title}"
									Grid.Column="2"
									FontSize="13">
									<TextBlock.Style>
										<Style
											TargetType="TextBlock"
											BasedOn="{StaticResource {x:Type TextBlock}}">
											<Style.Triggers>
												<DataTrigger
													Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}"
													Value="True">
													<Setter
														Property="Foreground"
														Value="White" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
								<TextBlock
									Text="{Binding Subtitle}"
									Grid.Column="2"
									Grid.Row="1"
									Margin="0,5,0,0">
									<TextBlock.Style>
										<Style
											TargetType="TextBlock"
											BasedOn="{StaticResource {x:Type TextBlock}}">
											<Style.Triggers>
												<DataTrigger
													Binding="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ListBoxItem}, Path=IsSelected}"
													Value="True">
													<Setter
														Property="Foreground"
														Value="White" />
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</Grid>
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>
			</Grid>

			<Grid
				Grid.Row="3"
				Margin="0,5,0,0">
				<Grid.Style>
					<Style
						TargetType="Grid">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding ElementName=BoxFile, Path=Text}"
								Value="">
								<Setter
									Property="IsEnabled"
									Value="False" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</Grid.Style>
				<Grid.ColumnDefinitions>
					<ColumnDefinition
						Width="Auto" />
					<ColumnDefinition
						Width="*" />
					<ColumnDefinition
						Width="Auto" />
				</Grid.ColumnDefinitions>
				<StackPanel
					Orientation="Horizontal">
					<Button
						Grid.Column="0"
						Content="{DynamicResource TitleExtractFile}"
						Padding="20,5"
						Command="{Binding ExtractCommand}">
						<Button.Style>
							<Style
								TargetType="Button"
								BasedOn="{StaticResource {x:Type Button}}">
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding ElementName=ListFiles, Path=SelectedIndex}"
										Value="-1">
										<Setter
											Property="IsEnabled"
											Value="False" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
					<CheckBox
						Content="{DynamicResource TitleOpenExtractedLocation}"
						IsChecked="{Binding OpenExtracted}"
						Padding="5"
						Margin="5,0,0,0" />
					<CheckBox
						Content="{DynamicResource TitleMountPackages}"
						ToolTip="{DynamicResource ToolTipMountPackages}"
						IsChecked="{Binding MountPackages}"
						Padding="5"
						Margin="5,0,0,0" />
					<CheckBox
						Content="{DynamicResource TitleFindAnim}"
						IsChecked="{Binding SearchAnim}"
						Padding="5"
						Margin="5,0,0,0">
						<CheckBox.Style>
							<Style
								TargetType="CheckBox"
								BasedOn="{StaticResource {x:Type CheckBox}}">
								<Setter
									Property="IsEnabled"
									Value="False" />
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding CurrentPack.SelectedFile.Extension}"
										Value="PMD">
										<Setter
											Property="IsEnabled"
											Value="True" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding CurrentPack.SelectedFile.Extension}"
										Value="PMG">
										<Setter
											Property="IsEnabled"
											Value="True" />
									</DataTrigger>
									<DataTrigger
										Binding="{Binding CurrentPack.SelectedFile.Extension}"
										Value="PMC">
										<Setter
											Property="IsEnabled"
											Value="True" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</CheckBox.Style>
					</CheckBox>
					<Button
						Content="{DynamicResource TitleGlanceFile}"
						Padding="10,5"
						Command="{Binding ReadFileCommand}">
						<Button.Style>
							<Style
								TargetType="Button"
								BasedOn="{StaticResource {x:Type Button}}">
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding CurrentPack.SelectedFile.IsDir}"
										Value="True">
										<Setter
											Property="IsEnabled"
											Value="False" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</Button.Style>
					</Button>
				</StackPanel>

				<Button
					Grid.Column="2"
					Content="{DynamicResource TitleEDF}"
					ToolTip="{DynamicResource TooltipEDF}"
					Padding="10,5"
					Command="{Binding ExtractAllCommand}">
				</Button>
			</Grid>
		</Grid>
	</Grid>
	
</base:BaseWindow>
