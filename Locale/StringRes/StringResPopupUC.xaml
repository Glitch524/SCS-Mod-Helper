<base:BaseUserControl
	x:Class="SCS_Mod_Helper.Locale.StringRes.StringResPopupUC"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:SCS_Mod_Helper.Locale.StringRes"
	xmlns:l="clr-namespace:SCS_Mod_Helper.Locale.Localization"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	d:DataContext="{d:DesignInstance Type=local:StringResBinding}"
	mc:Ignorable="d" 
	d:DesignWidth="250">
	<Grid
		x:Name="PanelMain">
		<Border
			Style="{DynamicResource PopupBorder}" />
		<StackPanel
			Margin="10">
			<TextBlock
				Margin="0,0,0,5"
				Text="{DynamicResource MenuResTip}" />
			<Separator
				Height="1"
				Background="{StaticResource TextFillColorSecondaryBrush}" />
			<TreeView
				x:Name="TreeViewStringRes"
				d:ItemsSource="{d:SampleData ItemCount=2}"
				ItemsSource="{Binding LocaleModules}"
				SelectedItemChanged="StringResSelectedChanged"
				Margin="0">
				<TreeView.Resources>
					<HierarchicalDataTemplate
						DataType="{x:Type l:LocaleModule}"
						ItemsSource="{Binding UniversalDict}">
						<StackPanel
							Orientation="Horizontal">
							<TextBlock
								Text="{Binding ModuleName}" />
						</StackPanel>
					</HierarchicalDataTemplate>
					<HierarchicalDataTemplate
						DataType="{x:Type l:LocalePair}">
						<StackPanel
							Orientation="Horizontal">
							<TextBlock
								Text="{Binding Key}" />
						</StackPanel>
					</HierarchicalDataTemplate>
				</TreeView.Resources>
				<TreeView.ItemContainerStyle>
					<Style
						TargetType="TreeViewItem"
						BasedOn="{StaticResource {x:Type TreeViewItem}}">
						<Setter
							Property="Focusable"
							Value="{Binding Focusable}" />
						<Setter
							Property="IsSelected"
							Value="{Binding Selected}" />
						<Style.Triggers>
							<Trigger
								Property="Focusable"
								Value="False">
								<Setter
									Property="IsExpanded"
									Value="{Binding Expanded, Mode=TwoWay}" />
							</Trigger>
						</Style.Triggers>
					</Style>
				</TreeView.ItemContainerStyle>
				<TreeView.Style>
					<Style
						TargetType="TreeView"
						BasedOn="{StaticResource {x:Type TreeView}}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding HasValue}"
								Value="False">
								<Setter
									Property="Visibility"
									Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TreeView.Style>
			</TreeView>
			<TextBlock
				Text="{DynamicResource StatusEmpty}"
				Margin="5,5">
				<TextBlock.Style>
					<Style
						TargetType="TextBlock"
						BasedOn="{StaticResource {x:Type TextBlock}}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding HasValue}"
								Value="False">
								<Setter
									Property="Visibility"
									Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style>
			</TextBlock>
			<Separator
				Height="1"
				Background="{StaticResource TextFillColorSecondaryBrush}" />
			<Button
				Margin="0,5,0,0"
				Padding="20,2"
				Content="{DynamicResource MenuResOption}"
				Click="ButtonClick" />
		</StackPanel>
	</Grid>
</base:BaseUserControl>
