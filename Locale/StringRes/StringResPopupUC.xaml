<base:BaseUserControl
	x:Class="SCS_Mod_Helper.Locale.StringRes.StringResPopupUC"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:local="clr-namespace:SCS_Mod_Helper.Locale.StringRes"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	d:DataContext="{d:DesignInstance Type=local:StringResBinding}"
	mc:Ignorable="d" 
	d:DesignWidth="250">
	<Grid
		x:Name="PanelMain">
		<Border
			Style="{DynamicResource PopupBorder}" />
		<StackPanel
			Margin="10">
			<TextBlock
				Margin="0,0,0,5"
				Text="{DynamicResource MenuResTip}" />
			<Separator
				Height="1"
				Background="{StaticResource TextFillColorSecondaryBrush}" />
			<ListBox
				x:Name="ListStringRes"
				SelectionMode="Single"
				d:ItemsSource="{d:SampleData ItemCount=2}"
				ItemsSource="{Binding StringResList}"
				SelectionChanged="StringResSelectionChanged"
				Margin="0,5">
				<ListBox.Style>
					<Style
						TargetType="ListBox"
						BasedOn="{StaticResource {x:Type ListBox}}">
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding StringResList.Count}"
								Value="0">
								<Setter
									Property="Visibility"
									Value="Collapsed" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</ListBox.Style>
				<ListBox.ItemTemplate>
					<DataTemplate>
						<TextBlock
							Background="{x:Null}"
							Text="{Binding Header}"
							ToolTip="{Binding Values}"
							Padding="0,5"
							HorizontalAlignment="Stretch">
						</TextBlock>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
			<TextBlock
				Text="{DynamicResource StatusEmpty}"
				Margin="5,5">
				<TextBlock.Style>
					<Style
						TargetType="TextBlock"
						BasedOn="{StaticResource {x:Type TextBlock}}">
						<Setter
							Property="Visibility"
							Value="Collapsed" />
						<Style.Triggers>
							<DataTrigger
								Binding="{Binding StringResList.Count}"
								Value="0">
								<Setter
									Property="Visibility"
									Value="Visible" />
							</DataTrigger>
						</Style.Triggers>
					</Style>
				</TextBlock.Style></TextBlock>
			<Separator
				Height="1"
				Background="{StaticResource TextFillColorSecondaryBrush}" />
			<Button
				Margin="0,5,0,0"
				Padding="20,2"
				Content="{DynamicResource MenuResOption}"
				Click="ButtonClick" />
		</StackPanel>
	</Grid>
</base:BaseUserControl>
