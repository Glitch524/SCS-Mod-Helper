<base:BasePage
	x:Class="SCS_Mod_Helper.Setting.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Setting"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	d:DataContext="{d:DesignInstance Type=local:SettingsBinding}"
	mc:Ignorable="d"
	d:DesignWidth="800"
	d:Background="White">
	<base:BasePage.Resources>
		<Style
			TargetType="Button"
			BasedOn="{StaticResource {x:Type Button}}">
			<Setter
				Property="Background"
				Value="{x:Null}" />
		</Style>
		<Style
			TargetType="ui:CardExpander" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
			<Setter
				Property="ContentPadding"
				Value="15,0,0,5" />
			<Setter
				Property="IsExpanded"
				Value="True" />
		</Style>
		<Style
			x:Key="CardPanelStyle"
			TargetType="StackPanel">
			<Setter
				Property="Orientation"
				Value="Horizontal" />
		</Style>
		<Style
			x:Key="CardTitleStyle"
			TargetType="ui:TextBlock">
			<Setter
				Property="FontTypography"
				Value="BodyStrong" />
			<Setter
				Property="VerticalAlignment"
				Value="Center" />
			<Setter
				Property="Margin"
				Value="10,0,0,0" />
		</Style>
		<Style
			x:Key="CardExpanderIconStyle"
			TargetType="Viewbox">
			<Setter
				Property="Height"
				Value="30" />
		</Style>
		<Style
			x:Key="CardControlIconStyle"
			TargetType="Viewbox">
			<Setter
				Property="Height"
				Value="40" />
		</Style>
		<Style
			x:Key="StaticInfoBarStyle"
			TargetType="ui:InfoBar"
			BasedOn="{StaticResource {x:Type ui:InfoBar}}">
			<Setter
				Property="IsOpen"
				Value="True" />
			<Setter
				Property="IsClosable"
				Value="False" />
			<Setter
				Property="FontSize"
				Value="12" />
			<Setter
				Property="VerticalAlignment"
				Value="Center" />
		</Style>
	</base:BasePage.Resources>
	<StackPanel
		x:Name="PanelMain">
		<ui:CardExpander>
			<ui:CardExpander.Header>
				<StackPanel
					Style="{StaticResource CardPanelStyle}">
					<Viewbox
						Style="{StaticResource CardExpanderIconStyle}">
						<ui:SymbolIcon
							Symbol="Settings20" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						Text="{DynamicResource TitleSettings}"
						VerticalAlignment="Center"
						Margin="10,0,0,0" />
				</StackPanel>
			</ui:CardExpander.Header>
			<StackPanel>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="Translate20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}"
								Text="{DynamicResource AppLanguage}" />
						</StackPanel>
					</ui:CardControl.Header>
					<ComboBox
						DisplayMemberPath="LanguageName"
						SelectedValuePath="Locale"
						ItemsSource="{Binding Languages}"
						SelectedValue="{Binding CurrentLanguage}"
						Width="150"
						Padding="5" />
				</ui:CardControl>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<ui:InfoBar
						Message="{DynamicResource TipsCustomLanguage}"
						Style="{StaticResource StaticInfoBarStyle}"/>
					<ui:SplitButton
						x:Name="ButtonDirLanguage"
						Grid.Column="1"
						Width="150"
						Margin="15,0,15,0"
						Background="Transparent"
						Command="{Binding OpenLanguageCommand}"
						Content="{DynamicResource ButtonLanguageDir}">
						<ui:SplitButton.Flyout>
							<ContextMenu>
								<MenuItem
									Header="{DynamicResource ButtonGenerateSample}"
									Command="{Binding GenerateSampleCommand}" />
							</ContextMenu>
						</ui:SplitButton.Flyout>
					</ui:SplitButton>
				</Grid>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="PaintBrush20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}"
								Text="{DynamicResource ColorMode}" />
						</StackPanel>
					</ui:CardControl.Header>
					<ComboBox
						Width="150"
						SelectedValue="{Binding CurrentTheme}"
						SelectedValuePath="Tag"
						Padding="5">
						<ComboBoxItem
							Content="{DynamicResource ThemeFollowSystem}"
							Tag="FollowSystem" />
						<ComboBoxItem
							Content="{DynamicResource ThemeLight}"
							Tag="Light" />
						<ComboBoxItem
							Content="{DynamicResource ThemeDark}"
							Tag="Dark" />
					</ComboBox>
				</ui:CardControl>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="Search20" />
							</Viewbox>
							<StackPanel>
								<ui:TextBlock
									Style="{StaticResource CardTitleStyle}"
									Text="{DynamicResource TitleUpdateCheckFrequency}" />
								<ui:TextBlock
									Text="{DynamicResource MessageUpdateCheckFrequency}"
									FontSize="12"
									Margin="10,5,0,0" />
							</StackPanel>
						</StackPanel>
					</ui:CardControl.Header>
					<ComboBox
						Width="150"
						SelectedValue="{Binding UpdateCheckFrequency}"
						SelectedValuePath="Tag"
						Padding="5">
						<ComboBoxItem
							Content="{DynamicResource ItemHourly}"
							Tag="hourly" />
						<ComboBoxItem
							Content="{DynamicResource ItemDaily}"
							Tag="daily" />
						<ComboBoxItem
							Content="{DynamicResource ItemWeekly}"
							Tag="weekly" />
						<ComboBoxItem
							Content="{DynamicResource ItemNever}"
							Tag="never" />
					</ComboBox>
				</ui:CardControl>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="SearchInfo20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}"
								Text="{DynamicResource TitleShowUpdateNotification}" />
						</StackPanel>
					</ui:CardControl.Header>
					<ui:ToggleSwitch
						IsChecked="{Binding ShowUpdateAvailable}" />
				</ui:CardControl>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="Bug20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}"
								Text="{DynamicResource TitleMaxStoreExcpCount}" />
						</StackPanel>
					</ui:CardControl.Header>
					<ui:NumberBox 
						Minimum="0"
						Width="150"
						MaxDecimalPlaces="0"
						Value="{Binding StoredExceptionCount, UpdateSourceTrigger=PropertyChanged}"/>
				</ui:CardControl>
			</StackPanel>
		</ui:CardExpander>

		<ui:CardExpander>
			<ui:CardExpander.Header>
				<StackPanel
					Style="{StaticResource CardPanelStyle}">
					<Viewbox
						Style="{StaticResource CardExpanderIconStyle}">
						<ui:SymbolIcon
							Symbol="FolderMultiple16" />
					</Viewbox>
					<ui:TextBlock
						Style="{StaticResource CardTitleStyle}"
						Text="{DynamicResource TitlePaths}" />
				</StackPanel>
			</ui:CardExpander.Header>
			<StackPanel>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<Image
									Source="/Images/Icon_ETS2.png" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}">
								<Run
									Text="{DynamicResource ETS2}" />
								<Run
									Text="{DynamicResource ExternalToolsPath}" />
								<Run
									Text=" " />
								<Run
									FontWeight="Bold"
									Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									Text="{Binding ETS2GamePath}"
									d:Text="ETS2 Path" />
							</ui:TextBlock>
						</StackPanel>
					</ui:CardControl.Header>
					<Button
						x:Name="ButtonBrowsePathETS2"
						Width="150"
						Content="{DynamicResource ButtonBrowse}"
						Padding="0,5,0,5"
						Click="ButtonClick" />
				</ui:CardControl>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<Image
									Source="/Images/Icon_ATS.png" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}">
								<Run
									Text="{DynamicResource ATS}" />
								<Run
									Text="{DynamicResource ExternalToolsPath}" />
								<Run
									Text=" " />
								<Run
									FontWeight="Bold"
									Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									Text="{Binding ATSGamePath}"
									d:Text="ATS Path" />
							</ui:TextBlock>
						</StackPanel>
					</ui:CardControl.Header>
					<Button
						x:Name="ButtonBrowsePathATS"
						Width="150"
						Content="{DynamicResource ButtonBrowse}"
						Padding="0,5,0,5"
						Click="ButtonClick"
						Margin="0,5,0,0" />
				</ui:CardControl>
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition
							Width="*" />
						<ColumnDefinition
							Width="Auto" />
					</Grid.ColumnDefinitions>
					<ui:InfoBar
						Message="{DynamicResource TipsAutoDetect}"
						Style="{StaticResource StaticInfoBarStyle}"/>
					<Button
						x:Name="ButtonCheckPath"
						Grid.Column="1"
						Width="150"
						Padding="0,5,0,5"
						Click="ButtonClick"
						Margin="15,0,15,0"
						Content="{DynamicResource ButtonAutoDetect}" />
				</Grid>

				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="BoxSearch20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}">
								<Hyperlink
									NavigateUri="https://github.com/mwl4/ConverterPIX"
									RequestNavigate="HyperlinkClick">Converter PIX</Hyperlink>
								<Run
									Text="{DynamicResource ExternalToolsPath}" />
								<Run
									Text="{Binding ConverterPixPath}"
									Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									d:Text="Converter Pix Path" />
							</ui:TextBlock>
						</StackPanel>
					</ui:CardControl.Header>
					<Button
						x:Name="ButtonConverterPix"
						Width="150"
						Content="{DynamicResource ButtonBrowse}"
						Padding="0,5,0,5"
						Click="ButtonClick" />
				</ui:CardControl>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="BoxEdit20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}">
								<Hyperlink
									NavigateUri="https://modding.scssoft.com/wiki/Documentation/Tools/Conversion_Tools"
									RequestNavigate="HyperlinkClick">Conversion Tools</Hyperlink>
								<Run
									Text="{DynamicResource ExternalToolsPath}" />
								<Run
									Text="{Binding ConversionToolsPath}"
									Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									d:Text="Conversion Tools Path" />
							</ui:TextBlock>
						</StackPanel>
					</ui:CardControl.Header>
					<Button
						x:Name="ButtonConversionTools"
						Width="150"
						Content="{DynamicResource ButtonBrowse}"
						Padding="0,5,0,5"
						Click="ButtonClick" />
				</ui:CardControl>
				<ui:CardControl>
					<ui:CardControl.Header>
						<StackPanel
							Style="{StaticResource CardPanelStyle}">
							<Viewbox
								Style="{StaticResource CardControlIconStyle}">
								<ui:SymbolIcon
									Symbol="FolderZip20" />
							</Viewbox>
							<ui:TextBlock
								Style="{StaticResource CardTitleStyle}">
								<Run
									Text="{DynamicResource TitleCommonModFolder}" />
								<Run
									Text="{DynamicResource ExternalToolsPath}" />
								<Run
									Text="{Binding CommonModPath}"
									Foreground="{DynamicResource TextFillColorSecondaryBrush}"
									d:Text="Common Mod Folder Path" />
							</ui:TextBlock>
						</StackPanel>
					</ui:CardControl.Header>
					<Button
						x:Name="ButtonModFolder"
						Width="150"
						Content="{DynamicResource ButtonBrowse}"
						Padding="0,5,0,5"
						Click="ButtonClick" />
				</ui:CardControl>
			</StackPanel>
		</ui:CardExpander>
	</StackPanel>
</base:BasePage>
