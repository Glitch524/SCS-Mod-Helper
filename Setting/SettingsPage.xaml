<base:BasePage
	x:Class="SCS_Mod_Helper.Setting.SettingsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Setting"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	d:DataContext="{d:DesignInstance Type=local:SettingsBinding}"
	mc:Ignorable="d"
	d:DesignWidth="800"
	d:Background="White">
	<base:BasePage.Resources>
		<Style
			TargetType="Button"
			BasedOn="{StaticResource {x:Type Button}}">
			<Setter
				Property="Background"
				Value="{x:Null}" />
		</Style>
	</base:BasePage.Resources>
	<StackPanel
		x:Name="PanelMain"
		Orientation="Vertical">
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="Translate20" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						Text="{DynamicResource AppLanguage}"
						VerticalAlignment="Center"
						Margin="10,0,0,0" />
				</StackPanel>
			</ui:CardControl.Header>
			<ComboBox
				DisplayMemberPath="LanguageName"
				SelectedValuePath="Locale"
				ItemsSource="{Binding Languages}"
				SelectedValue="{Binding CurrentLanguage}"
				Width="150"
				Padding="5" />
		</ui:CardControl>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<ui:InfoBar
				Message="{DynamicResource TipsCustomLanguage}"
				IsOpen="True"
				IsClosable="False"
				FontSize="12"
				VerticalAlignment="Center" />
			<Button
				x:Name="ButtonDirLanguage"
				Grid.Column="1"
				Width="150"
				Padding="0,5,0,5"
				Click="ButtonClick"
				Margin="15,0,15,0"
				Content="{DynamicResource ButtonLanguageDir}" />
		</Grid>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="PaintBrush20" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						Text="{DynamicResource ColorMode}"
						VerticalAlignment="Center"
						Margin="10,0,0,0" />
				</StackPanel>
			</ui:CardControl.Header>
			<ComboBox
				Width="150"
				SelectedValue="{Binding CurrentTheme}"
				SelectedValuePath="Tag"
				Padding="5">
				<ComboBoxItem
					Content="{DynamicResource ThemeFollowSystem}"
					Tag="FollowSystem" />
				<ComboBoxItem
					Content="{DynamicResource ThemeLight}"
					Tag="Light" />
				<ComboBoxItem
					Content="{DynamicResource ThemeDark}"
					Tag="Dark" />
			</ComboBox>
		</ui:CardControl>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="Search20" />
					</Viewbox>
					<StackPanel>
						<ui:TextBlock
							FontTypography="BodyStrong"
							Text="{DynamicResource TitleUpdateCheckFrequency}"
							VerticalAlignment="Center"
							Margin="10,0,0,0" />
						<ui:TextBlock
							FontSize="12"
							Text="{DynamicResource MessageUpdateCheckFrequency}"
							Margin="10,5,0,0" />
					</StackPanel>
				</StackPanel>
			</ui:CardControl.Header>
			<ComboBox
				Width="150"
				SelectedValue="{Binding UpdateCheckFrequency}"
				SelectedValuePath="Tag"
				Padding="5">
				<ComboBoxItem
					Content="{DynamicResource ItemHourly}"
					Tag="hourly" />
				<ComboBoxItem
					Content="{DynamicResource ItemDaily}"
					Tag="daily" />
				<ComboBoxItem
					Content="{DynamicResource ItemWeekly}"
					Tag="weekly" />
				<ComboBoxItem
					Content="{DynamicResource ItemNever}"
					Tag="never" />
			</ComboBox>
		</ui:CardControl>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="SearchInfo20" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						Text="{DynamicResource TitleShowUpdateNotification}"
						VerticalAlignment="Center"
						Margin="10,0,0,0" />
				</StackPanel>
			</ui:CardControl.Header>
			<ui:ToggleSwitch
				IsChecked="{Binding ShowUpdateAvailable}"/>
		</ui:CardControl>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<Image
							Source="/Images/Icon_ETS2.png" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						VerticalAlignment="Center"
						Margin="10,0,0,0">
						<Run
							Text="{DynamicResource ETS2}" />
						<Run
							Text="{DynamicResource ExternalToolsPath}" />
						<Run
							Text=" " />
						<Hyperlink
							Click="FilePathClick"
							Tag="{Binding ETS2GamePath}">
							<Run
								Text="{Binding ETS2GamePath}"
								FontWeight="Bold"
								d:Text="ETS2 Path" />
						</Hyperlink>
					</ui:TextBlock>
				</StackPanel>
			</ui:CardControl.Header>
			<Button
				x:Name="ButtonBrowsePathETS2"
				Width="150"
				Content="{DynamicResource ButtonBrowse}"
				Padding="0,5,0,5"
				Click="ButtonClick" />
		</ui:CardControl>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<Image
							Source="/Images/Icon_ATS.png" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						VerticalAlignment="Center"
						Margin="10,0,0,0">
						<Run
							Text="{DynamicResource ATS}" />
						<Run
							Text="{DynamicResource ExternalToolsPath}" />
						<Run
							Text=" " />
						<Hyperlink
							Click="FilePathClick"
							Tag="{Binding ATSGamePath}">
							<Run
								Text="{Binding ATSGamePath}"
								FontWeight="Bold"
								d:Text="ATS Path" />
						</Hyperlink>
					</ui:TextBlock>
				</StackPanel>
			</ui:CardControl.Header>
			<Button
				x:Name="ButtonBrowsePathATS"
				Width="150"
				Content="{DynamicResource ButtonBrowse}"
				Padding="0,5,0,5"
				Click="ButtonClick"
				Margin="0,5,0,0" />
		</ui:CardControl>
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition
					Width="*" />
				<ColumnDefinition
					Width="Auto" />
			</Grid.ColumnDefinitions>
			<ui:InfoBar
				Message="{DynamicResource TipsAutoDetect}"
				IsOpen="True"
				FontSize="12"
				IsClosable="False"
				VerticalAlignment="Center" />
			<Button
				x:Name="ButtonCheckPath"
				Grid.Column="1"
				Width="150"
				Padding="0,5,0,5"
				Click="ButtonClick"
				Margin="15,0,15,0"
				Content="{DynamicResource ButtonAutoDetect}" />
		</Grid>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="BoxSearch20" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						VerticalAlignment="Center"
						Margin="10,0,0,0">
						<Hyperlink
							NavigateUri="https://github.com/mwl4/ConverterPIX"
							RequestNavigate="HyperlinkClick">Converter PIX</Hyperlink>
						<Run
							Text="{DynamicResource ExternalToolsPath}" />
						<Run
							Text="{Binding ConverterPixPath}"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							d:Text="Converter Pix Path" />
					</ui:TextBlock>
				</StackPanel>
			</ui:CardControl.Header>
			<Button
				x:Name="ButtonConverterPix"
				Width="150"
				Content="{DynamicResource ButtonBrowse}"
				Padding="0,5,0,5"
				Click="ButtonClick" />
		</ui:CardControl>
		<ui:CardControl>
			<ui:CardControl.Header>
				<StackPanel
					Orientation="Horizontal"
					Height="40">
					<Viewbox>
						<ui:SymbolIcon
							Symbol="BoxEdit20" />
					</Viewbox>
					<ui:TextBlock
						FontTypography="BodyStrong"
						VerticalAlignment="Center"
						Margin="10,0,0,0">
						<Hyperlink
							NavigateUri="https://modding.scssoft.com/wiki/Documentation/Tools/Conversion_Tools"
							RequestNavigate="HyperlinkClick">Conversion Tools</Hyperlink>
						<Run
							Text="{DynamicResource ExternalToolsPath}" />
						<Run
							Text="{Binding ConversionToolsPath}"
							Foreground="{DynamicResource TextFillColorSecondaryBrush}"
							d:Text="Conversion Tools Path" />
					</ui:TextBlock>
				</StackPanel>
			</ui:CardControl.Header>
			<Button
				x:Name="ButtonConversionTools"
				Width="150"
				Content="{DynamicResource ButtonBrowse}"
				Padding="0,5,0,5"
				Click="ButtonClick" />
		</ui:CardControl>
	</StackPanel>
</base:BasePage>
