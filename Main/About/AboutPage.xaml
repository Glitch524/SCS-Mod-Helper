<base:BasePage
	x:Class="SCS_Mod_Helper.Main.About.AboutPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Main.About"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	xmlns:util="clr-namespace:SCS_Mod_Helper.Utils"
	d:DataContext="{d:DesignInstance Type=local:AboutBinding}"
	mc:Ignorable="d"
	d:Background="White"
	Title="{DynamicResource TitleAbout}">
	<base:BasePage.Resources>
		<Style
			TargetType="TextBlock"
			BasedOn="{StaticResource {x:Type TextBlock}}">
			<Setter
				Property="TextWrapping"
				Value="Wrap" />
			<Setter
				Property="FontSize"
				Value="14" />
		</Style>
	</base:BasePage.Resources>
	<Grid
		x:Name="GridMain"
		Margin="40">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="Auto" />
			<ColumnDefinition
				Width="5" />
			<ColumnDefinition 
				Width="Auto"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="Auto" />
		</Grid.RowDefinitions>
		<StackPanel>
			<Image
				Width="100"
				Source="{Binding Avatar}"
				d:Source="/Images/AppIcon.ico">
				<Image.Clip>
					<EllipseGeometry
						Center="50,50"
						RadiusX="50"
						RadiusY="50" />
				</Image.Clip>
			</Image>
			<TextBlock
				HorizontalAlignment="Center"
				Margin="0,5,0,0">
				<Hyperlink
					Command="{Binding UserLinkCommand}">
					<Run
						Text="{Binding Username}"
						d:Text="Glitch524"/>
				</Hyperlink>
			</TextBlock>
		</StackPanel>
		<Grid
			Grid.Column="2"
			Margin="50,0,0,0">
			<Grid.RowDefinitions>
				<RowDefinition
					Height="Auto" />
				<RowDefinition
					Height="*" />
				<RowDefinition
					Height="Auto" />
			</Grid.RowDefinitions>
			<TextBlock>
				<Run
					Text="Github:" />
				<Hyperlink
					NavigateUri="https://github.com/Glitch524/SCS-Model-Helper"
					RequestNavigate="HyperlinkClick">SCS Mod Helper</Hyperlink>
				<LineBreak />
				<Run
					Text="{DynamicResource HeaderVersion}" />
				<Run
					Text="{DynamicResource Version}" />
			</TextBlock>
			<StackPanel
				Grid.Row="2"
				Grid.Column="1"
				Margin="0,15,0,0">
				<TextBlock
					Margin="0,5,0,0"
					Text="{DynamicResource HeaderSupport}" />
				<TextBlock
					x:Name="TextKoFi"
					Margin="20,5,0,0">
					<TextBlock.Style>
						<Style
							TargetType="TextBlock"
							BasedOn="{StaticResource {x:Type TextBlock}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding IsCN}"
									Value="True">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
					<Run
						Text="Ko-Fi:" />
					<Hyperlink
						NavigateUri="https://ko-fi.com/glitch524"
						RequestNavigate="HyperlinkClick">Glitch524</Hyperlink>
				</TextBlock>
				<TextBlock
					x:Name="TextBilibili"
					Margin="20,5,0,0">
					<TextBlock.Style>
						<Style
							TargetType="TextBlock"
							BasedOn="{StaticResource {x:Type TextBlock}}">
							<Style.Triggers>
								<DataTrigger
									Binding="{Binding IsCN}"
									Value="False">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
								</DataTrigger>
							</Style.Triggers>
						</Style>
					</TextBlock.Style>
					<Run
						Text="←如果不介意可以在B站充电" />
					<LineBreak />
					<Run
						Text="←里面也有基本的MOD教程" />
				</TextBlock>
			</StackPanel>
		</Grid>
		<TextBlock
			Grid.Row="2"
			Grid.ColumnSpan="3"
			Margin="0,30,0,0">
			<Run
				Text="{DynamicResource Desc}" />
		</TextBlock>
    </Grid>
</base:BasePage>
