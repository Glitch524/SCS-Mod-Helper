<base:BaseWindow
	x:Class="SCS_Mod_Helper.Main.NaviMainWindow"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Main"
	xmlns:about="clr-namespace:SCS_Mod_Helper.Main.About"
	xmlns:setting="clr-namespace:SCS_Mod_Helper.Setting"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:manifest="clr-namespace:SCS_Mod_Helper.Manifest"
	d:DataContext="{d:DesignInstance Type=local:MainBinding}"
	mc:Ignorable="d"
	Loaded="NaviMainWindowLoaded"
	Title="SCS Mod Helper"
	Height="700"
	Width="1200"
	ExtendsContentIntoTitleBar="True"
	Style="{DynamicResource BaseWindowStyle}">
	<Grid
		x:Name="GridMain">
		<Grid.RowDefinitions>
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<ui:TitleBar
			Title="SCS Mod Helper"
			VerticalAlignment="Top"
			VerticalContentAlignment="Stretch">
			<ui:TitleBar.Icon>
				<ui:ImageIcon
					Source="/Images/AppIcon.png" />
			</ui:TitleBar.Icon>
		</ui:TitleBar>
		<ui:NavigationView
			x:Name="Navigation"
			Grid.Row="1"
			IsBackButtonVisible="Collapsed"
			OpenPaneLength="200">
			<ui:NavigationView.MenuItems>
				<ui:NavigationViewItem
					Content="{DynamicResource TitleModManifest}"
					Icon="{ui:SymbolIcon DocumentEdit20}"
					TargetPageType="{x:Type manifest:ModManifestPage}"
					TargetPageTag="ModManifest" />
				<ui:NavigationViewItem
					Content="{DynamicResource TitleAccessory}"
					Icon="{ui:SymbolIcon Chess20}"
					TargetPageType="{x:Type local:AccessoryMainPage}"
					TargetPageTag="AccessoryMainPage" />
				<ui:NavigationViewItem
					Content="{DynamicResource TitleSetupLocalization}"
					Icon="{ui:SymbolIcon BookOpenGlobe20}"
					Command="{Binding WindowCommand}"
					CommandParameter="ModLocalization" />
				<ui:NavigationViewItem
					Content="{DynamicResource TitleSetupPaintJob}"
					Icon="{ui:SymbolIcon PaintBrush20}"
					Command="{Binding WindowCommand}"
					CommandParameter="PaintJob" />
				<ui:NavigationViewItem
					Content="{DynamicResource TitleConverterPIX}"
					Icon="{ui:SymbolIcon BoxSearch20}"
					Command="{Binding WindowCommand}"
					CommandParameter="ConverterPIX"
					Cursor="Hand" />
				<ui:NavigationViewItem
					Content="{DynamicResource TitleShortcut}"
					Icon="{ui:SymbolIcon Send20}"
					Cursor="Hand"
					TargetPageType="{x:Type local:ShortcutPage}"
					TargetPageTag="Shortcuts" />
				<ui:NavigationViewItem
					Content="{DynamicResource TitleExports}"
					Icon="{ui:SymbolIcon ArrowExportUp20}"
					Cursor="Hand"
					TargetPageType="{x:Type local:ExportsPage}"
					TargetPageTag="Exports"/>
				<ui:NavigationViewItem
					Content="Test"
					Icon="{ui:SymbolIcon Lightbulb20}"
					Command="{Binding TestCommand}"
					CommandParameter="test"
					Visibility="{Binding TestVisibility}"
					Cursor="Hand" />
			</ui:NavigationView.MenuItems>
			<ui:NavigationView.FooterMenuItems>
				<ui:NavigationViewItem
					Content="{DynamicResource TitleAbout}"
					Icon="{ui:SymbolIcon Info28}"
					TargetPageType="{x:Type about:AboutPage}">
					<ui:NavigationViewItem.InfoBadge>
						<ui:InfoBadge
							Value="↑"
							Margin="0,0,5,0"
							Severity="Attention"
							d:Visibility="Visible">
							<ui:InfoBadge.Style>
								<Style
									TargetType="ui:InfoBadge"
									BasedOn="{StaticResource {x:Type ui:InfoBadge}}">
									<Setter
										Property="Visibility"
										Value="Collapsed" />
									<Style.Triggers>
										<MultiDataTrigger>
											<MultiDataTrigger.Conditions>
												<Condition
													Binding="{Binding HasUpdate}"
													Value="True" />
												<Condition
													Binding="{Binding ShowInfoBadge}"
													Value="True" />
											</MultiDataTrigger.Conditions>
											<MultiDataTrigger.Setters>
												<Setter
													Property="Visibility"
													Value="Visible" />
											</MultiDataTrigger.Setters>
										</MultiDataTrigger>
									</Style.Triggers>
								</Style>
							</ui:InfoBadge.Style>
						</ui:InfoBadge>
					</ui:NavigationViewItem.InfoBadge>
				</ui:NavigationViewItem>
				<ui:NavigationViewItem
					Content="{DynamicResource TitleSettings}"
					Icon="{ui:SymbolIcon Settings32}"
					TargetPageType="{x:Type setting:SettingsPage}" />
			</ui:NavigationView.FooterMenuItems>
		</ui:NavigationView>
	</Grid>
</base:BaseWindow>
