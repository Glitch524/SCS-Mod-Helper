<base:BasePage
	x:Class="SCS_Mod_Helper.Main.ExportsPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
	xmlns:local="clr-namespace:SCS_Mod_Helper.Main"
	xmlns:base="clr-namespace:SCS_Mod_Helper.Class.Base"
	mc:Ignorable="d"
	d:DesignWidth="991"
	d:Background="White"
	Title="{DynamicResource TitleExports}">
	<base:BasePage.Resources>
		<Style
			x:Key="ButtonStyle"
			TargetType="Button"
			BasedOn="{StaticResource {x:Type Button}}">
			<Setter
				Property="Width"
				Value="130" />
			<Setter
				Property="Background"
				Value="{x:Null}" />
			<Setter
				Property="BorderThickness"
				Value="0" />
			<Setter
				Property="Padding"
				Value="5" />
			<Setter
				Property="Cursor"
				Value="Hand" />
			<Setter
				Property="VerticalContentAlignment"
				Value="Top" />
			<Setter
				Property="VerticalAlignment"
				Value="Stretch" />
			<EventSetter
				Event="Click"
				Handler="ButtonClick" />
		</Style>
	</base:BasePage.Resources>
	<StackPanel>
		<Expander
			Header="{DynamicResource TitleOthers}"
			IsExpanded="True">
			<WrapPanel>
				<Button
					x:Name="ButtonLockZip"
					Style="{StaticResource ButtonStyle}"
					Tag="LockZip|">
					<StackPanel>
						<Viewbox
							Width="120"
							Height="120">
							<ui:SymbolIcon
								Symbol="FolderZip20" />
						</Viewbox>
						<TextBlock
							Text="{DynamicResource TitleLockZip}"
							TextWrapping="Wrap"
							Margin="5,0"
							TextAlignment="Center" />
					</StackPanel>
				</Button>
			</WrapPanel>
		</Expander>
	</StackPanel>
</base:BasePage>
